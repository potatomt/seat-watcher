# Copy to .env and fill in. All optional — sane defaults apply if unset.

# Port the Express server binds on 127.0.0.1 (nginx proxies to this).
PORT=5173

# NOTE: ntfy.sh push notifications are configured per-browser now (each
# visitor sets their own topic in the page's Manage Targets > Notifications
# panel, stored with their session) — there's no global NTFY_TOPIC anymore.
# If you're upgrading from a version that had one set, migration carries it
# over automatically into the pre-existing "default" session, one time only.

# Poll interval in minutes. Overrides the built-in 3-minute default when set.
POLL_MINUTES=3

# Optional proxy for the scraper's browser (e.g. socks5://127.0.0.1:1055).
# Edugate is geo-restricted, so if this server runs somewhere outside Saudi
# Arabia, point this at a Tailscale exit node (or any proxy) that's inside
# the country. Leave unset to connect directly — normal for local dev where
# you're already on a Saudi network/VPN.
PROXY_URL=
